PORT=8080
ENVIRONMENT=development
DATABASE_URL=sqlite:///./feature_flags.db
REDIS_URL=
API_KEY=
CACHE_TTL_SECONDS=60
CACHE_MAXSIZE=10000
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_STARTUP=true

